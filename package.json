{
  "name": "ride-share-backend",
  "version": "1.0.0",
  "description": "Real-time driver tracking backend: Express REST API and Socket.IO namespaces",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "NODE_ENV=test node --test \"test/*.test.js\"",
    "lint": "eslint .",
    "simulate": "node scripts/simulate-drivers.js"
  },
  "keywords": [
    "ride-sharing",
    "real-time",
    "websockets",
    "express"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "supertest": "^7.3.2"
  },
  "engines": {
    "node": ">=22.12"
  }
}
