# Copy to .env and fill in. npm start/dev and docker compose both read it.

# Required in production (the server refuses to start without it).
# Generate one with: openssl rand -hex 32
# Outside production a random per-process secret is used when this is empty.
JWT_SECRET=

PORT=3001
NODE_ENV=development

# Extra browser origins allowed to call the API, comma-separated.
# The page's own origin is always allowed. Defaults to the Vite dev/preview ports outside production.
CORS_ORIGINS=

# Failed logins per client and username per 15 minutes.
LOGIN_RATE_LIMIT=10
# Location updates per minute: per driver over REST, per connection over WebSocket.
LOCATION_RATE_LIMIT=60
